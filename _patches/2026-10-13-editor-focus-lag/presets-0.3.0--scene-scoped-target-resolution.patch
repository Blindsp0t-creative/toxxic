+//
+//  Both steps are SCENE SCOPED (see ScopeOf below) : the show keeps a
+//  single content scene loaded at a time, so most targets of the bank
+//  point into a scene that is currently out of play.
 // ============================================================
 
+using System;
 using UnityEditor;
 using UnityEngine;
+using UnityEngine.SceneManagement;
 using Object = UnityEngine.Object;
 
 namespace Presets
@@ -30,21 +36,91 @@
             return GlobalObjectId.GlobalObjectIdentifierToObjectSlow(gid);
         }
 
+        // ── Scene scoping ────────────────────────────────────────────
+        //
+        // A scene-object GlobalObjectId carries the GUID of the scene asset
+        // it lives in. When that scene is not loaded there is nothing to
+        // resolve, and asking anyway is expensive :
+        //   - GlobalObjectIdentifierToObjectSlow does a slow lookup and
+        //     fires a native "Assertion failed : manager != NULL", which
+        //     drags a managed stack-trace extraction and a log write;
+        //   - the by-name fallback then walks EVERY GameObject in memory.
+        // That was paid per out-of-scene target, on every capture and
+        // every preset recall (and recalls can be quantized to the beat).
+        //
+        // Scoping also closes a correctness hole : several scenes hold
+        // objects with the SAME name (ANCHOR_VR exists in all three content
+        // scenes, ANCHOR_Rokoko in two). An unscoped by-name fallback could
+        // resolve a target of scene A to the homonym in scene B and then
+        // apply the wrong preset to it.
+        //
+        // Everything here fails OPEN : when the scene of an id cannot be
+        // determined we go through the normal path, exactly as before.
+
+        enum IdScope
+        {
+            Unknown,        // not a scene object, or scene undeterminable
+            SceneLoaded,
+            SceneNotLoaded,
+        }
+
+        const string NullGuid = "00000000000000000000000000000000";
+        const int    SceneObjectIdType = 2;   // GlobalObjectId.identifierType
+
+        static IdScope ScopeOf(string id, out Scene scene)
+        {
+            scene = default;
+            if (string.IsNullOrEmpty(id)) return IdScope.Unknown;
+            if (!GlobalObjectId.TryParse(id, out var gid)) return IdScope.Unknown;
+            if (gid.identifierType != SceneObjectIdType) return IdScope.Unknown;
+
+            string guid = gid.assetGUID.ToString();
+            if (string.IsNullOrEmpty(guid) || guid == NullGuid) return IdScope.Unknown;
+
+            string path = AssetDatabase.GUIDToAssetPath(guid);
+            if (string.IsNullOrEmpty(path)) return IdScope.Unknown;
+            if (!path.EndsWith(".unity", StringComparison.OrdinalIgnoreCase)) return IdScope.Unknown;
+
+            // Not in the hierarchy at all, or present but unloaded : either
+            // way the object cannot be reached right now.
+            scene = SceneManager.GetSceneByPath(path);
+            if (!scene.IsValid() || !scene.isLoaded)
+            {
+                scene = default;
+                return IdScope.SceneNotLoaded;
+            }
+            return IdScope.SceneLoaded;
+        }
+
+        /// <summary>
+        /// True when <paramref name="id"/> anchors into a scene that is not
+        /// loaded. Call sites use it to stay quiet instead of warning about
+        /// a target that is simply out of play right now.
+        /// </summary>
+        public static bool TargetSceneUnloaded(string id)
+            => ScopeOf(id, out _) == IdScope.SceneNotLoaded;
+
         // ── GameObject resolution ────────────────────────────────────
 
         public static GameObject ResolveGameObject(string id, string nameFallback)
         {
+            var scope = ScopeOf(id, out var scene);
+            if (scope == IdScope.SceneNotLoaded) return null;
+
             var obj = Resolve(id);
             if (obj is GameObject go) return go;
             if (obj is Component c)   return c.gameObject;
-            return FindGOInScene(nameFallback);
+
+            // Keep the fallback inside the target's own scene when we know it.
+            return FindGOInScene(nameFallback, scope == IdScope.SceneLoaded ? scene : default);
         }
 
         // ── Component resolution ─────────────────────────────────────
 
         public static Component ResolveComponent(string compId, string typeName, GameObject ownerFallback)
         {
-            if (Resolve(compId) is Component c) return c;
+            if (ScopeOf(compId, out _) != IdScope.SceneNotLoaded
+                && Resolve(compId) is Component c) return c;
 
             // Fallback : find a component of the stored type on the owner GO.
             if (ownerFallback != null && !string.IsNullOrEmpty(typeName))
@@ -73,14 +149,24 @@
         /// inactive objects — fatal for active-state save / restore.
         /// </summary>
         public static GameObject FindGOInScene(string goName)
+            => FindGOInScene(goName, default);
+
+        /// <summary>
+        /// Same, restricted to <paramref name="restrictTo"/> when that scene
+        /// is valid. Prevents a target of one scene from latching onto a
+        /// homonym in another one.
+        /// </summary>
+        public static GameObject FindGOInScene(string goName, Scene restrictTo)
         {
             if (string.IsNullOrEmpty(goName)) return null;
+            bool scoped = restrictTo.IsValid();
             foreach (GameObject go in Resources.FindObjectsOfTypeAll<GameObject>())
             {
                 if (go.name != goName) continue;
                 if (go.hideFlags != HideFlags.None) continue;
                 // Skip prefab assets / objects not in a loaded scene.
                 if (!go.scene.IsValid()) continue;
+                if (scoped && go.scene != restrictTo) continue;
                 return go;
             }
             return null;
