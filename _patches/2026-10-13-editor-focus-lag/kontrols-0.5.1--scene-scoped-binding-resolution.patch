+        // ── Scene scoping ────────────────────────────────────────────
+        //
+        // A scene-object GlobalObjectId carries the GUID of the scene asset it
+        // lives in. When that scene is not loaded the binding cannot resolve,
+        // and asking anyway is expensive : GlobalObjectIdentifierToObjectSlow
+        // does a slow lookup AND fires a native "Assertion failed : manager !=
+        // NULL", which drags a managed stack-trace extraction and a log write
+        // behind it. A show that keeps one content scene loaded at a time has
+        // most of its bindings in that state, so this used to be paid dozens of
+        // times per hierarchy change.
+        //
+        // Everything here fails OPEN : when the scene of an id cannot be
+        // determined, resolution proceeds exactly as before.
+
+        const string NullGuid          = "00000000000000000000000000000000";
+        const int    SceneObjectIdType = 2;   // GlobalObjectId.identifierType
+
+        static readonly HashSet<string> s_LoadedSceneGuids = new HashSet<string>();
+        static string s_LoadedSceneSig;
+
+        /// <summary>
+        /// Refreshes the loaded-scene GUID set and reports whether it moved.
+        /// </summary>
+        static bool LoadedSceneSetChanged()
+        {
+            var sb = new System.Text.StringBuilder();
+            for (int i = 0; i < SceneManager.sceneCount; i++)
+            {
+                var sc = SceneManager.GetSceneAt(i);
+                sb.Append(sc.handle).Append(sc.isLoaded ? ":1;" : ":0;");
+            }
+            string sig = sb.ToString();
+            if (sig == s_LoadedSceneSig) return false;
+            s_LoadedSceneSig = sig;
+
+            s_LoadedSceneGuids.Clear();
+            for (int i = 0; i < SceneManager.sceneCount; i++)
+            {
+                var sc = SceneManager.GetSceneAt(i);
+                if (!sc.isLoaded || string.IsNullOrEmpty(sc.path)) continue;
+                string guid = AssetDatabase.AssetPathToGUID(sc.path);
+                if (!string.IsNullOrEmpty(guid)) s_LoadedSceneGuids.Add(guid);
+            }
+            return true;
+        }
+
+        static bool TargetSceneLoaded(GlobalObjectId gid)
+        {
+            if (gid.identifierType != SceneObjectIdType) return true;   // asset, not a scene object
+
+            string guid = gid.assetGUID.ToString();
+            if (string.IsNullOrEmpty(guid) || guid == NullGuid) return true;
+
+            LoadedSceneSetChanged();                      // keeps the set current
+            if (s_LoadedSceneGuids.Count == 0) return true;   // unknown state : do not block
+            return s_LoadedSceneGuids.Contains(guid);
+        }
