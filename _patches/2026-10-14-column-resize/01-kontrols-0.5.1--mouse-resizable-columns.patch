+#if UNITY_EDITOR
+using System.Collections.Generic;
+using System.Globalization;
+using System.Text;
+using Kontrols.Internal;
+using UnityEditor;
+using UnityEngine;
+
+namespace Kontrols
+{
+    /// <summary>
+    /// Mouse-resizable column band.
+    ///
+    /// <para><c>[Column(weight)]</c> declares the authored split. Dragging the
+    /// strip on the right of a column stores a per-tab override in EditorPrefs
+    /// that wins over the attributes until it is reset (double-click or
+    /// right-click the strip). A drag only moves width between the two slots it
+    /// separates : the band total is preserved, so the other columns never
+    /// shift.</para>
+    ///
+    /// <para>A band has one slot more than it has columns : the trailing slot is
+    /// the empty space on the right of the last column. Dragging the rightmost
+    /// strip trades width between the last column and that space, so the band
+    /// does not have to fill the window.</para>
+    ///
+    /// <para>Overrides are keyed by tab name and validated against the slot
+    /// count, so adding or removing a <c>[Column]</c> in code drops a stale
+    /// layout instead of mis-applying it.</para>
+    /// </summary>
+    public abstract partial class KontrolsWindow
+    {
+        // ── Tunables ─────────────────────────────────────────────────
+        const float SPLITTER_W = 5f;    // grab strip reserved on the right of a column
+
+        /// <summary>Narrowest a band column can be dragged, in pixels. Override
+        /// in a window that wants to squeeze a column further, bearing in mind
+        /// that a control line holds fixed-width parts of its own.</summary>
+        protected virtual float MinColumnWidth => 120f;
+
+        // ── State ────────────────────────────────────────────────────
+        // tab name → one weight per slot : one per band column in drawn (index)
+        // order, plus the trailing empty space.
+        readonly Dictionary<string, float[]> _colWeights = new Dictionary<string, float[]>();
+
+        string _dragLayoutTab      = null;  // tab owning the splitter being dragged
+        int    _dragLayoutSplitter = -1;    // index of the slot on its left, -1 = no drag
+
+        string ColumnLayoutKey(string tab) => $"Kontrols_{PrefsNamespace}_colw_{tab}";
+
+        // Only a band column constrains width ; the trailing space can close
+        // completely, which is what every band did before it existed.
+        float SlotMinWidth(int slot, int columnCount) =>
+            slot < columnCount ? MinColumnWidth : 0f;
+
+        // ── Weights ──────────────────────────────────────────────────
+
+        /// <summary>Live slot weights for a tab band : the persisted override
+        /// when it still matches the band, else the authored attribute weights
+        /// with no trailing space.</summary>
+        float[] GetColumnWeights(string tabName, List<ColumnModel> band)
+        {
+            int slots = band.Count + 1;
+            if (_colWeights.TryGetValue(tabName, out var cached) &&
+                cached != null && cached.Length == slots)
+                return cached;
+
+            var w = LoadColumnLayout(tabName, slots) ?? AuthoredWeights(band);
+            _colWeights[tabName] = w;
+            return w;
+        }
+
+        static float[] AuthoredWeights(List<ColumnModel> band)
+        {
+            var w = new float[band.Count + 1];
+            for (int i = 0; i < band.Count; i++)
+                w[i] = Mathf.Max(0.0001f, band[i].Weight);
+            w[band.Count] = 0f;             // band fills the width, as authored
+            return w;
+        }
+
+        // ── Persistence ──────────────────────────────────────────────
+
+        // Returns null when nothing valid is stored for this band shape.
+        float[] LoadColumnLayout(string tabName, int slots)
+        {
+            string key = ColumnLayoutKey(tabName);
+            if (!EditorPrefs.HasKey(key)) return null;
+
+            var parts = EditorPrefs.GetString(key, "").Split(',');
+
+            // One value short = a layout saved before the trailing space
+            // existed. Adopt it with no trailing space, which is how it was
+            // rendered back then.
+            bool legacy = parts.Length == slots - 1;
+            if (parts.Length != slots && !legacy) return null;
+
+            var w = new float[slots];
+            for (int i = 0; i < parts.Length; i++)
+            {
+                if (!float.TryParse(parts[i], NumberStyles.Float,
+                                    CultureInfo.InvariantCulture, out float v))
+                    return null;
+                if (float.IsNaN(v) || float.IsInfinity(v)) return null;
+
+                bool trailing = !legacy && i == slots - 1;
+                if (trailing ? v < 0f : v <= 0f) return null;
+                w[i] = v;
+            }
+            return w;
+        }
+
+        void SaveColumnLayout(string tabName)
+        {
+            if (!_colWeights.TryGetValue(tabName, out var w) || w == null) return;
+
+            var sb = new StringBuilder();
+            for (int i = 0; i < w.Length; i++)
+            {
+                if (i > 0) sb.Append(',');
+                sb.Append(w[i].ToString("F5", CultureInfo.InvariantCulture));
+            }
+            EditorPrefs.SetString(ColumnLayoutKey(tabName), sb.ToString());
+        }
+
+        // Drops the override and goes back to the [Column] weights.
+        void ResetColumnLayout(string tabName, List<ColumnModel> band)
+        {
+            EditorPrefs.DeleteKey(ColumnLayoutKey(tabName));
+            _colWeights[tabName] = AuthoredWeights(band);
+        }
+
+        // ── Splitters ────────────────────────────────────────────────
+
+        // Called once per band, after its columns have been laid out, with the x
+        // of the strip reserved on the right of each column and the band rect.
+        // Draws the grips and runs the drag. Never called during the Layout
+        // pass, where those rects are not known yet.
+        void HandleColumnSplitters(string tabName, List<ColumnModel> band, float[] weights,
+                                   float[] gapX, Rect bandRect, float avail, float sumWeights)
+        {
+            var e = Event.current;
+
+            for (int i = 0; i < gapX.Length; i++)
+            {
+                var strip = new Rect(gapX[i], bandRect.y, SPLITTER_W, bandRect.height);
+                bool hot  = _dragLayoutSplitter == i && _dragLayoutTab == tabName;
+
+                if (e.type == EventType.Repaint)
+                {
+                    var line = new Rect(strip.x + (SPLITTER_W - 1f) * 0.5f, strip.y + 2f,
+                                        1f, Mathf.Max(0f, strip.height - 4f));
+                    EditorGUI.DrawRect(line, hot
+                        ? new Color(1f, 1f, 1f, 0.55f)
+                        : (EditorGUIUtility.isProSkin ? new Color(1f, 1f, 1f, 0.14f)
+                                                      : new Color(0f, 0f, 0f, 0.17f)));
+                }
+
+                EditorGUIUtility.AddCursorRect(strip, MouseCursor.ResizeHorizontal);
+
+                switch (e.type)
+                {
+                    case EventType.MouseDown:
+                        if (e.button != 0 || !strip.Contains(e.mousePosition)) break;
+                        if (e.clickCount == 2)
+                        {
+                            ResetColumnLayout(tabName, band);
+                            Repaint();
+                        }
+                        else
+                        {
+                            _dragLayoutTab      = tabName;
+                            _dragLayoutSplitter = i;
+                        }
+                        e.Use();
+                        break;
+
+                    case EventType.MouseDrag:
+                        // No Contains test : the window keeps the drag once the
+                        // button went down on the strip, so the pointer is free
+                        // to travel outside it.
+                        if (!hot) break;
+                        if (DragSplitter(weights, i, e.delta.x, avail, sumWeights,
+                                         SlotMinWidth(i,     band.Count),
+                                         SlotMinWidth(i + 1, band.Count)))
+                            Repaint();
+                        e.Use();
+                        break;
+
+                    case EventType.MouseUp:
+                        if (!hot) break;
+                        _dragLayoutTab      = null;
+                        _dragLayoutSplitter = -1;
+                        SaveColumnLayout(tabName);
+                        e.Use();
+                        break;
+
+                    case EventType.ContextClick:
+                        if (!strip.Contains(e.mousePosition)) break;
+                        var menu = new GenericMenu();
+                        menu.AddItem(new GUIContent("Reset column widths"), false, () =>
+                        {
+                            ResetColumnLayout(tabName, band);
+                            Repaint();
+                        });
+                        menu.ShowAsContext();
+                        e.Use();
+                        break;
+                }
+            }
+        }
+
+        // Moves width between slots left and left+1 only : their sum is
+        // preserved, so sumWeights stays valid for the whole band and no other
+        // slot moves. minLeftPx / minRightPx are pixel floors, 0 for the
+        // trailing space. Returns true when something changed.
+        static bool DragSplitter(float[] weights, int left, float dx, float avail,
+                                 float sumWeights, float minLeftPx, float minRightPx)
+        {
+            int right = left + 1;
+            if (right >= weights.Length)                      return false;
+            if (dx == 0f || avail <= 0f || sumWeights <= 0f)  return false;
+
+            float perPixel = sumWeights / avail;          // weight units per pixel
+            float minLeft  = minLeftPx  * perPixel;
+            float minRight = minRightPx * perPixel;
+            float pair     = weights[left] + weights[right];
+            if (pair <= minLeft + minRight) return false;  // band too narrow to redistribute
+
+            float newLeft = Mathf.Clamp(weights[left] + dx * perPixel,
+                                        minLeft, pair - minRight);
+            if (Mathf.Approximately(newLeft, weights[left])) return false;
+
+            weights[left]  = newLeft;
+            weights[right] = pair - newLeft;
+            return true;
+        }
+    }
+}
+#endif
