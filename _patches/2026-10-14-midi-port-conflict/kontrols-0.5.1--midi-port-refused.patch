+    // -------------------------------------------------------
+    // Ports refused by the driver
+    // -------------------------------------------------------
+
+    /// <summary>Records a port the driver would not open, and says so once.
+    /// The port is deliberately left out of <see cref="_ports"/> so the retry
+    /// keeps trying and the UI stops claiming it is connected.</summary>
+    static void NoteBusyPort(string name, string error)
+    {
+        string why = string.IsNullOrEmpty(error) ? "the driver refused the port" : error;
+        if (_busyPorts.TryGetValue(name, out var known) && known == why) return;
+
+        _busyPorts[name] = why;
+        Debug.LogWarning(
+            $"[MidiHub] '{name}' could not be opened : {why}\n" +
+            "MIDI inputs are exclusive on Windows, so another application is most " +
+            "likely holding this controller. Free it there : Kontrols retries every " +
+            $"{OPEN_RETRY_S:0} s and takes the port back on its own.");
+        OnConnectionChanged?.Invoke();
+    }
+
+    /// <summary>Clears a port from the busy list once it opens.</summary>
+    static void ClearBusyPort(string name)
+    {
+        if (_busyPorts.Remove(name)) OnConnectionChanged?.Invoke();
+    }
+
+    /// <summary>Reads every port name in one pass and refreshes
+    /// <see cref="_availablePorts"/>, notifying the UI when the set changes.</summary>
+    static List<string> ReadPortNames(int portCount)
+    {
+        var names = new List<string>(portCount);
+        for (int i = 0; i < portCount; i++)
+        {
+            var check = MidiIn.Create();
+            names.Add(check?.GetPortName(i) ?? $"Port {i}");
+            check?.Dispose();
+        }
+
+        bool changed = names.Count != _availablePorts.Count;
+        for (int i = 0; i < names.Count && !changed; i++)
+            changed = names[i] != _availablePorts[i];
+
+        if (changed)
+        {
+            _availablePorts.Clear();
+            _availablePorts.AddRange(names);
+            OnConnectionChanged?.Invoke();
+        }
+        return names;
+    }
+
+    /// <summary>Closes one open In port and the feedback port that came with
+    /// it, leaving the rest of the connection untouched.</summary>
+    static void ClosePort(string name)
+    {
+        int idx = _portNames.IndexOf(name);
+        if (idx >= 0)
+        {
+            try { _ports[idx]?.Dispose(); } catch { }
+            _ports.RemoveAt(idx);
+            _portNames.RemoveAt(idx);
+        }
+
+        int outIdx = _outPortNames.IndexOf(name);
+        if (outIdx >= 0)
+        {
+            var outPort = _outPorts[outIdx];
+            _failedOutPorts.Remove(outPort);
+            try { outPort?.Dispose(); } catch { }
+            _outPorts.RemoveAt(outIdx);
+            _outPortNames.RemoveAt(outIdx);
+        }
+    }
