+    // -------------------------------------------------------
+    // Dispatch isolation
+    //
+    // Every subscriber runs in its own try/catch. A plain event invoke stops
+    // at the first handler that throws : the handlers after it never get the
+    // message, ProcessQueue is left mid-queue, and EditorApplication.update
+    // skips its remaining callbacks for the frame. A subscriber that throws on
+    // every message (a binding to a destroyed object, say) would silence every
+    // subscriber registered after it - knobs dead with the port alive.
+    // -------------------------------------------------------
+
+    const double HandlerErrorMute = 5.0;   // s between two reports of the same failing handler
+    private static readonly Dictionary<System.Delegate, double> _handlerErrorAt
+        = new Dictionary<System.Delegate, double>();
+
+    /// <summary>Calls <paramref name="call"/> on each subscriber of
+    /// <paramref name="handlers"/>, each in its own try/catch.</summary>
+    static void Each<T>(T handlers, System.Action<T> call) where T : System.Delegate
+    {
+        if (handlers == null) return;
+        foreach (var handler in handlers.GetInvocationList())
+        {
+            try { call((T)handler); }
+            catch (System.Exception e) { ReportHandlerError(handler, e); }
+        }
+    }
+
+    // A knob being turned sends dozens of messages a second : a handler that
+    // throws on each is reported once per HandlerErrorMute, not per message.
+    static void ReportHandlerError(System.Delegate handler, System.Exception e)
+    {
+        double now = EditorApplication.timeSinceStartup;
+        if (_handlerErrorAt.TryGetValue(handler, out double at) && now - at < HandlerErrorMute) return;
+        _handlerErrorAt[handler] = now;
+
+        var m = handler.Method;
+        Debug.LogError($"[MidiHub] {m.DeclaringType?.Name}.{m.Name} threw while handling MIDI - the " +
+                       $"other subscribers were still served (muted for {HandlerErrorMute:0} s) :\n{e}");
+    }
+
